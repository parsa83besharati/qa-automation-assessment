# ==================== APPLICATION UNDER TEST ====================
# Booking.com UI under test (all UI navigation resolves via config/env.ts)
BOOKING_BASE_URL=https://www.booking.com
# AutomationExercise API under test
API_BASE_URL=https://automationexercise.com

# Browser: false = headed (useful locally, Booking has bot protection)
HEADLESS=true

# ==================== BOOKING SEARCH DEFAULTS (Task 1) ====================
# Currency to select on homepage (Task: TRY — Turkish lira)
DEFAULT_CURRENCY=TRY
# Destination to search (Task: London, pick first suggestion)
DEFAULT_DESTINATION=London
# Occupancy (Task: 8 adults)
DEFAULT_ADULTS=8
# Pets travelling flag (Task: enabled)
TRAVELLING_WITH_PETS=true
# Which hotel in results to open (Task: 3rd hotel's "See availability")
TARGET_HOTEL_INDEX=3

# ==================== API LATENCY SLO (Task 2) ====================
# Budget in ms for a single API call — mirrors the k6 threshold p(95)<1500
API_LATENCY_BUDGET_MS=1500

# ==================== SELF-HEALING (AI) ====================
# Master switch — set true to enable AI/heuristic selector healing
SELF_HEALING_ENABLED=false
# Healing mode: runtime (heal during test) or post-mortem (log only)
HEALING_MODE=runtime

# ==================== LLM PROVIDERS (optional — heuristic works without keys) ====================
# Priority: DeepSeek > OpenAI > Anthropic > Custom/Local
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-haiku-20240307

CUSTOM_LLM_API_KEY=sk-local
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=llama3

# ==================== LOGGING ====================
# debug | info | warn | error (console level; files always capture info+)
LOG_LEVEL=info
# Pretty color logs in terminal: true/false
LOG_PRETTY=true
